<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.google.cloud.gcs.analytics</groupId>
        <artifactId>gcs-analytics-core-parent</artifactId>
        <version>1.7.1-SNAPSHOT</version>
    </parent>
    <name>gcs-analytics-core</name>
    <artifactId>gcs-analytics-core</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.google.cloud.gcs.analytics</groupId>
            <artifactId>client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Shaded and relocated into this jar so consumers never see Parquet's generated types or
          internal Thrift classes on their classpath. Marked optional because the classes are
          bundled, so consumers must not also get the artifact as a transitive dependency. This
          replaces a dependency-reduced POM, which is written into this module's directory by
          default, and which shifts basedir and drops core from the aggregate JaCoCo report in
          coverage/ when moved under target/.
        -->
        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-format-structures</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          The Thrift runtime shaded into parquet-format-structures still logs through unshaded
          slf4j, but its POM does not declare it.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!--
          Test dependencies for unit tests only. The Parquet/Hadoop/Avro stack is NOT here on
          purpose: no test under src/test/java references it, and pulling hadoop-common into every
          `mvn test` drags in ~80 transitive jars. It lives in the integration-test and jmh
          profiles, which are the only sources that actually use it.
        -->
        <dependency>
            <groupId>com.google.truth</groupId>
            <artifactId>truth</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.cloud.gcs.analytics</groupId>
            <artifactId>test-lib</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!--
                  Failsafe runs the integration tests against this shaded jar, but they compile
                  against the unrelocated classes in target/classes. A call from an integration test
                  to a method whose signature names a Parquet format or Thrift type therefore
                  compiles and then fails with NoSuchMethodError.
                -->
                <executions>
                    <execution>
                        <id>shade-parquet-format</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.apache.parquet:parquet-format-structures</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>org.apache.parquet:parquet-format-structures</artifact>
                                    <excludes>
                                        <exclude>parquet.thrift</exclude>
                                        <!--
                                          This jar has its own manifest, and the copied Maven
                                          metadata would make scanners report an unshaded
                                          parquet-format-structures inside it.
                                        -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                        <!--
                                          Util decodes footers with the plain compact protocol,
                                          which does not cap strings or containers, and only Util
                                          uses the event package. Leaving both out keeps
                                          BoundedCompactProtocol the only way to decode a footer.
                                        -->
                                        <exclude>org/apache/parquet/format/Util*.class</exclude>
                                        <exclude>org/apache/parquet/format/event/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <!--
                                  Relocate under com.google.cloud.gcs.analyticscore.** so
                                  hadoop-connectors also bundles and re-relocates these classes.
                                -->
                                <relocation>
                                    <pattern>org.apache.parquet.format</pattern>
                                    <shadedPattern>com.google.cloud.gcs.analyticscore.internal.shaded.parquet.format</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>shaded.parquet.org.apache.thrift</pattern>
                                    <shadedPattern>com.google.cloud.gcs.analyticscore.internal.shaded.parquet.thrift</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          The integration tests under src/integrationTest/java read and write real Parquet files,
          so they need the Parquet/Hadoop/Avro stack. It is scoped to this profile so unit test
          runs stay lean.
        -->
        <profile>
            <id>integration-test</id>
            <dependencies>
                <dependency>
                    <groupId>org.apache.parquet</groupId>
                    <artifactId>parquet-column</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.parquet</groupId>
                    <artifactId>parquet-hadoop</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.parquet</groupId>
                    <artifactId>parquet-avro</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.avro</groupId>
                    <artifactId>avro</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-common</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-mapreduce-client-core</artifactId>
                    <scope>test</scope>
                </dependency>
                <!--
                  slf4j-simple rather than slf4j-log4j12: the latter is a relocation stub that
                  resolves to slf4j-reload4j, pulling a log4j 1.2 fork onto the test classpath.
                -->
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
